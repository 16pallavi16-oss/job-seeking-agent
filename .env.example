# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/job_seeker_bot

# Groq — https://console.groq.com/keys (free tier, no billing/card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SerpApi (Google Jobs engine) — https://serpapi.com
SERPAPI_API_KEY=

# Frontend -> backend
BACKEND_URL=http://localhost:8000

# Local file storage for uploaded resumes
UPLOAD_DIR=./uploads
